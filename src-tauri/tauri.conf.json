{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaDownloader",
  "version": "0.1.0",
  "identifier": "com.mediendownloader.app",
  "build": {
    "beforeDevCommand": "npm run check-sidecars && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run check-sidecars && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MediaDownloader",
        "width": 640,
        "height": 580,
        "minWidth": 480,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "visible": true,
        "focus": true,
        "theme": "Dark",
        "backgroundColor": "#0B0910"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "externalBin": ["binaries/yt-dlp", "binaries/qjs"]
  }
}
